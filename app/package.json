{
  "name": "signahead",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node server/ai-proxy.mjs",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "vite build",
    "start": "node server/ai-proxy.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');const path=require('path');const p=path.join('node_modules','.vite');if(fs.existsSync(p))fs.rmSync(p,{recursive:true,force:true})\"",
    "test:ai": "node server/evaluate-rag.mjs",
    "test:advisor": "node server/evaluate-advisor.mjs",
    "test:advisor:live": "node server/evaluate-advisor-live.mjs",
    "test:e2e": "node tests/e2e/mvp-flow.mjs",
    "test:e2e:legacy": "npm run clean && playwright test --config=playwright.legacy.config.js",
    "verify:mvp": "node scripts/verify/mvp-walkthrough.mjs",
    "test:unit": "node tests/unit/risk-mapper.test.mjs && node tests/unit/amount-engine.test.mjs && node tests/unit/contract-docx.test.mjs && node tests/unit/contract-facts.test.mjs && node tests/unit/contract-review-playbook.test.mjs && node tests/unit/contract-review-playbook-cases.test.mjs && node tests/unit/legal-basis.test.mjs && node tests/unit/ai-review-reliability.test.mjs && node tests/unit/ai-chat-request.test.mjs && node tests/unit/ai-proxy-lifecycle.test.mjs",
    "test:contract-review-benchmark": "node scripts/test-contract-review-benchmark.mjs",
    "test:review-reliability": "node tests/unit/ai-review-reliability.test.mjs && node tests/unit/ai-chat-request.test.mjs",
    "test:contract-review-playbook": "node tests/unit/contract-review-playbook.test.mjs",
    "test:contract-playbook-cases": "node tests/unit/contract-review-playbook-cases.test.mjs && node scripts/evaluate-contract-playbook-cases.mjs",
    "test:contract-facts": "node tests/unit/contract-facts.test.mjs",
    "test:real-contract-review": "node scripts/run-real-contract-review.mjs",
    "test:legal-basis": "node tests/unit/legal-basis.test.mjs",
    "generate:contract-review-cases": "node scripts/generate-contract-review-cases.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
